# Copie para .env (cp .env.exemplo .env) e ajuste. O .env não vai para o git.
# O mesmo arquivo serve ao servidor Hindsight (linhas HINDSIGHT_API_*) e aos comandos do kit.

# ---- Comandos do kit (memoria, carga.py, semana.py, avalia.py) ----
HINDSIGHT_URL=http://127.0.0.1:8891
# Nome do banco de memória (um por projeto ou pessoa). É criado na primeira gravação.
HINDSIGHT_BANCO=projeto
# Nome do serviço systemd do servidor (o instalar.sh usa este nome)
HINDSIGHT_SERVICO=memoria-hindsight

# ---- Servidor Hindsight (lido pelo hindsight-api) ----
# Só na sua máquina: não abra para a rede.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8891

# LLM pela assinatura do Claude (Claude Code CLI logado), sem chave de API.
# A documentação do Hindsight diz que o provedor claude-code é para uso pessoal/local.
HINDSIGHT_API_LLM_PROVIDER=claude-code
HINDSIGHT_API_LLM_MODEL=claude-haiku-5-5
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=pt-BR

# Vetores: bge-m3 (multilíngue) no Ollama local, pela rota compatível com OpenAI.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=bge-m3
# Texto qualquer: o Ollama não usa chave (o campo só precisa existir).
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=ollama

# Reordenação dos resultados na própria máquina (CPU). Baixa o modelo uma vez na 1ª subida.
HINDSIGHT_API_RERANKER_PROVIDER=local

# Banco de dados: PostgreSQL embutido (pg0). Os dados ficam em ~/.pg0 por padrão.
# HINDSIGHT_API_DATABASE_URL=pg0

# Não mandar telemetria
DO_NOT_TRACK=1
